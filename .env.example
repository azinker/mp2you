NEXT_PUBLIC_SITE_URL=https://www.morepower2you.com

# Sanity CMS / Studio
# Project ID: Sanity Manage > project > Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Usually production
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity Manage > API > Tokens, Editor permission
SANITY_API_TOKEN=
# Any long random value for future preview mode
SANITY_PREVIEW_SECRET=
# Keep false until Sanity is seeded and verified
NEXT_PUBLIC_USE_SANITY=false

# Contact form email
# Resend > API Keys
RESEND_API_KEY=
# Inbox that receives lead notifications
CONTACT_FORM_TO_EMAIL=
# Optional internal BCC recipient for lead notifications
CONTACT_FORM_BCC_EMAIL=
# Use onboarding@resend.dev for testing; use verified domain email before launch
CONTACT_FORM_FROM_EMAIL=MorePower2You <onboarding@resend.dev>

# Cloudflare Turnstile
# Cloudflare Dashboard > Turnstile > widget site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Dashboard > Turnstile > widget secret key
TURNSTILE_SECRET_KEY=

# Optional database if a future non-Sanity submission store is added
DATABASE_URL=
